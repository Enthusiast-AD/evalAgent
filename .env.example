# AgentGuard - environment template
# Copy to .env and fill in.

# Postgres connection string (Neon, Supabase, RDS, ...)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Gemini API key - enables LLM scenario generation and real-agent mode.
# Without it, AgentGuard runs fully deterministically in the simulator.
GEMINI_API_KEY=""

# Optional Gemini overrides
GEMINI_MODEL="gemini-2.0-flash"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
